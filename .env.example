# --- Required ---
# Get one at https://platform.openai.com/api-keys
# Set a $10/month usage cap in the OpenAI dashboard.
OPENAI_API_KEY=sk-paste-your-key-here

# --- Model selection (defaults are fine for the MVP) ---
SETTLEREADY_PROVIDER=openai          # openai | ollama (ollama provider is a stub for now)
SETTLEREADY_CHAT_MODEL=gpt-4o-mini
SETTLEREADY_EMBED_MODEL=text-embedding-3-small
# Ollama settings (used when SETTLEREADY_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b

# --- Optional: LangSmith tracing (free at smith.langchain.com) ---
# Traces every Thought -> Action -> Observation step. Highly recommended for debugging.
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=settleready

# --- Optional: real email intake (free, via Gmail IMAP/SMTP, stdlib only) ---
# Default is the mock JSON inbox. Set these to process real emails:
#   1. Create a dedicated Gmail account for the demo
#   2. Turn on 2-Step Verification, then create an App Password
#      (Google Account -> Security -> App passwords)
#   3. Fill in below. Never commit this file.
# SETTLEREADY_EMAIL_SOURCE=gmail
# GMAIL_ADDRESS=settlesready.demo@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
