# --- Required ---
# Get one at https://platform.openai.com/api-keys
# Set a $10/month usage cap in the OpenAI dashboard.
OPENAI_API_KEY=sk-paste-your-key-here

# --- Model selection (defaults are fine for the MVP) ---
SETTLEREADY_PROVIDER=openai          # openai | ollama (ollama provider is a stub for now)
SETTLEREADY_CHAT_MODEL=gpt-4o-mini
SETTLEREADY_EMBED_MODEL=text-embedding-3-small
# Ollama settings (used when SETTLEREADY_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b

# --- Optional: LangSmith tracing (free at smith.langchain.com) ---
# Traces every Thought -> Action -> Observation step. Highly recommended for debugging.
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=settleready

# --- Optional: real email intake (free, via Gmail IMAP/SMTP, stdlib only) ---
# Three transports; pick one. Default (nothing set) is the mock JSON inbox.
#
# (a) Your own mailbox (operator): dedicated Gmail + app password, in YOUR
#     local .env only. Never commit this file.
# SETTLEREADY_EMAIL_SOURCE=gmail
# GMAIL_ADDRESS=settlesready.demo@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
#
# (b) Shared demo mailbox via relay (clones): the operator runs a relay
#     server (bash scripts/relay_server.sh) that alone holds the app
#     password. Clones need ONLY these two lines — no Gmail password ever
#     reaches their machines. RELAY_TOKEN is published on purpose: it is a
#     kill-switch (rotating it cuts off clones), not a secret.
# SETTLEREADY_EMAIL_SOURCE=relay
# RELAY_URL=https://your-relay-host:8899
# RELAY_TOKEN=public-demo-token
